{
  "name": "vs_transform",
  "version": "1.0.2",
  "description": "Transform.js is a microlib that aim to apply transformations on HTML element",
  "repository": "git@github.com:dthevenin/Transform.git",
  "author": "<david.thevenin@gmail.com>",
  "license": "MIT",
  "scripts": {
    "clean": "rimraf dist build",
    "prepublishOnly": "npm run clean && npm run build",
    "tsc": "tsc -p src/tsconfig.json",
    "make-bundle": "rollup --config",
    "build": "npm run clean && npm run tsc && npm run make-bundle",
    "test": "nyc mocha",
    "typecheck:test": "tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "gl-matrix": "^3.4.4",
    "vs_ui_utils": "../VS_ui_utils"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.3",
    "@istanbuljs/esm-loader-hook": "^0.3.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@typescript/typescript6": "^6.0.2",
    "happy-dom": "^21.0.3",
    "mocha": "^11.8.0",
    "nyc": "^18.0.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.7",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=15.0.0"
  },
  "type": "module",
  "main": "./dist/vs_transform.cjs",
  "module": "./dist/vs_transform.es.js",
  "types": "./dist/vs_transform.d.ts",
  "exports": {
    ".": {
      "types": "./dist/vs_transform.d.ts",
      "import": "./dist/vs_transform.es.js",
      "require": "./dist/vs_transform.cjs"
    }
  }
}
